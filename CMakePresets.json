{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 13,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "description": "Base preset for the candleLight USB2CANFD application: HPM_BUILD_TYPE=flash_dfu, i.e. an APP image linked at 0x80020000 which is started by hpm_dfu_boot at 0x80000000",
            "generator": "Ninja",
            "cacheVariables": {
                "HPM_BUILD_TYPE": "flash_dfu",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CUSTOM_TARGET_TRIPLET": "riscv-none-elf"
            }
        },
        {
            "name": "base-debug",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "base-uf2",
            "hidden": true,
            "inherits": "base",
            "description": "Base preset for UF2/MSC bootloader images: HPM_BUILD_TYPE=flash_uf2, i.e. an APP linked at 0x80020000 behind a .uf2_signature. Also emits <APP_NAME>.uf2 (family 0x0A4D5048) for drag-and-drop flashing. Only HSCanT ships UF2 presets because that image matches HSCanT's closed-source boot; other boards need their own UF2 boot project (write it from the hpm_sdk samples) and are DFU-only by default.",
            "cacheVariables": {
                "HPM_BUILD_TYPE": "flash_uf2"
            }
        },
        {
            "name": "base-uf2-debug",
            "hidden": true,
            "inherits": "base-uf2",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "hscant-dfu",
            "displayName": "HSCanT - DFU image (Release)",
            "inherits": "base",
            "cacheVariables": {
                "BOARD": "hscant"
            },
            "binaryDir": "${sourceDir}/build/hscant-dfu"
        },
        {
            "name": "hscant-uf2",
