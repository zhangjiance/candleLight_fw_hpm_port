{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 13,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "description": "Base preset for the candleLight USB2CANFD application: HPM_BUILD_TYPE=flash_dfu, i.e. an APP image linked at 0x80020000 which is started by hpm_dfu_boot at 0x80000000",
            "generator": "Ninja",
            "cacheVariables": {
                "HPM_BUILD_TYPE": "flash_dfu",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CUSTOM_TARGET_TRIPLET": "riscv-none-elf"
            }
        },
        {
            "name": "base-debug",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "base-uf2",
            "hidden": true,
            "inherits": "base",
            "description": "Base preset for UF2/MSC bootloader images: HPM_BUILD_TYPE=flash_uf2, i.e. an APP linked at 0x80020000 behind a .uf2_signature. Also emits <APP_NAME>.uf2 (family 0x0A4D5048) for drag-and-drop flashing.",
            "cacheVariables": {
                "HPM_BUILD_TYPE": "flash_uf2"
            }
        },
        {
            "name": "base-uf2-debug",
            "hidden": true,
            "inherits": "base-uf2",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "hscant-dfu",
            "displayName": "HSCanT - DFU image (Release)",
            "inherits": "base",
            "cacheVariables": {
                "BOARD": "hscant"
            },
            "binaryDir": "${sourceDir}/build/hscant-dfu"
        },
        {
            "name": "hscant-uf2",
            "displayName": "HSCanT - UF2 image (Release)",
            "inherits": "base-uf2",
            "cacheVariables": {
                "BOARD": "hscant"
            },
            "binaryDir": "${sourceDir}/build/hscant-uf2"
        },
        {
            "name": "hscant-dfu-debug",
            "displayName": "HSCanT - DFU image (Debug)",
            "inherits": "base-debug",
            "cacheVariables": {
                "BOARD": "hscant"
            },
            "binaryDir": "${sourceDir}/build/hscant-dfu-debug"
        },
        {
            "name": "hscant-uf2-debug",
            "displayName": "HSCanT - UF2 image (Debug)",
            "inherits": "base-uf2-debug",
            "cacheVariables": {
                "BOARD": "hscant"
            },
            "binaryDir": "${sourceDir}/build/hscant-uf2-debug"
        },
        {
            "name": "hscant-lite-dfu",
            "displayName": "HSCanT-Lite - DFU image (Release)",
            "inherits": "base",
            "cacheVariables": {
                "BOARD": "hscant-lite"
            },
            "binaryDir": "${sourceDir}/build/hscant-lite-dfu"
        },
        {
            "name": "hscant-lite-dfu-debug",
            "displayName": "HSCanT-Lite - DFU image (Debug)",
            "inherits": "base-debug",
            "cacheVariables": {
                "BOARD": "hscant-lite"
            },
            "binaryDir": "${sourceDir}/build/hscant-lite-dfu-debug"
        }
    ],
    "buildPresets": [
        {
            "name": "hscant-dfu",
            "displayName": "Build HSCanT - DFU image (Release)",
            "configurePreset": "hscant-dfu",
            "jobs": 8
        },
        {
            "name": "hscant-uf2",
            "displayName": "Build HSCanT - UF2 image (Release)",
            "configurePreset": "hscant-uf2",
            "jobs": 8
        },
        {
            "name": "hscant-dfu-debug",
            "displayName": "Build HSCanT - DFU image (Debug)",
            "configurePreset": "hscant-dfu-debug",
            "jobs": 8
        },
        {
            "name": "hscant-uf2-debug",
            "displayName": "Build HSCanT - UF2 image (Debug)",
            "configurePreset": "hscant-uf2-debug",
            "jobs": 8
        },
        {
            "name": "hscant-lite-dfu",
            "displayName": "Build HSCanT-Lite - DFU image (Release)",
            "configurePreset": "hscant-lite-dfu",
            "jobs": 8
        },
        {
            "name": "hscant-lite-dfu-debug",
            "displayName": "Build HSCanT-Lite - DFU image (Debug)",
            "configurePreset": "hscant-lite-dfu-debug",
            "jobs": 8
        }
    ]
}
